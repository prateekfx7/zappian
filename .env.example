# App Environment
ENVIRONMENT=development
LOG_LEVEL=INFO

# API & Web
API_HOST=0.0.0.0
API_PORT=8000
NEXT_PUBLIC_API_URL=http://localhost:8000
SECRET_KEY=change-this-in-production-dummy-secret-key-32-chars

# Database (PostgreSQL + pgvector)
POSTGRES_USER=framedna
POSTGRES_PASSWORD=framedna_secure_password
POSTGRES_DB=framedna
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://framedna:framedna_secure_password@localhost:5432/framedna

# Redis (Queue & Cache)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# Object Storage (MinIO / S3)
STORAGE_ENDPOINT=localhost:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET_NAME=framedna
STORAGE_USE_SSL=false
STORAGE_PUBLIC_URL=http://localhost:9000

# Pipeline Config & Limits
MAX_UPLOAD_SIZE_MB=500
MAX_VIDEO_DURATION_SECONDS=180
CHUNK_DURATION_SECONDS=45
CHUNK_OVERLAP_SECONDS=5

# Thresholds (Originality & Evidence)
ORIGINALITY_VISUAL_SIMILARITY_MAX=0.80
ORIGINALITY_TEXT_NGRAM_OVERLAP_MAX=0.10
ORIGINALITY_MAX_CONSECUTIVE_WORDS=8
EVIDENCE_TOLERANCE_MS=1000

# Model Provider Configurations
VLM_PROVIDER=qwen_vl
VLM_ENDPOINT=http://localhost:8001/v1
VLM_MODEL_NAME=Qwen/Qwen2.5-VL-7B-Instruct
LLM_PROVIDER=vllm
LLM_ENDPOINT=http://localhost:8001/v1
LLM_MODEL_NAME=Qwen/Qwen2.5-7B-Instruct
STT_MODEL_NAME=base
STT_DEVICE=cpu
OCR_PROVIDER=paddleocr
VIDEOGEN_PROVIDER=ltx
TTS_PROVIDER=kokoro

# Optional External APIs
YOUTUBE_API_KEY=
