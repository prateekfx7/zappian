# ReelBrain Production Environment Configuration

# 1. Environment & Server
ENVIRONMENT=production
LOG_LEVEL=INFO
SECRET_KEY=generate-a-secure-random-32-character-secret-key
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=https://your-domain.com,https://your-app.vercel.app

# 2. Frontend Connection
NEXT_PUBLIC_API_URL=https://api.your-domain.com

# 3. Database (PostgreSQL with pgvector extension)
POSTGRES_USER=framedna
POSTGRES_PASSWORD=your_secure_db_password
POSTGRES_DB=framedna
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://framedna:your_secure_db_password@postgres:5432/framedna

# 4. Redis (Queue & Cache)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# 5. Object Storage (S3 / MinIO / Cloudflare R2 / Supabase Storage)
STORAGE_ENDPOINT=minio:9000
STORAGE_ACCESS_KEY=your_minio_or_s3_key
STORAGE_SECRET_KEY=your_minio_or_s3_secret
STORAGE_BUCKET_NAME=framedna
STORAGE_USE_SSL=false
STORAGE_PUBLIC_URL=https://storage.your-domain.com

# 6. AI Providers & Grok Bot (xAI)
XAI_API_KEY=xai-your-api-key-here
GROK_API_KEY=xai-your-api-key-here
VLM_PROVIDER=qwen_vl
VLM_ENDPOINT=http://gpu-worker:8001/v1
VLM_MODEL_NAME=Qwen/Qwen2.5-VL-7B-Instruct
LLM_PROVIDER=vllm
LLM_ENDPOINT=http://gpu-worker:8001/v1
LLM_MODEL_NAME=Qwen/Qwen2.5-7B-Instruct
VIDEOGEN_PROVIDER=ltx
TTS_PROVIDER=kokoro

# 7. Pipeline Thresholds
MAX_UPLOAD_SIZE_MB=500
MAX_VIDEO_DURATION_SECONDS=180
CHUNK_DURATION_SECONDS=45
CHUNK_OVERLAP_SECONDS=5
ORIGINALITY_VISUAL_SIMILARITY_MAX=0.80
ORIGINALITY_TEXT_NGRAM_OVERLAP_MAX=0.10
ORIGINALITY_MAX_CONSECUTIVE_WORDS=8
EVIDENCE_TOLERANCE_MS=1000

# 8. Optional Integrations
YOUTUBE_API_KEY=

